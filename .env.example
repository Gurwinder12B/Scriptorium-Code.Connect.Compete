# SCRIPTORIUM Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# -----------------------------------------------------------------------------
# General Application Settings
# -----------------------------------------------------------------------------
FLASK_ENV=development
FLASK_APP=backend/run.py
SECRET_KEY=replace-with-a-random-secure-secret-key-32-chars-min
JWT_SECRET_KEY=replace-with-a-random-secure-jwt-secret-key-32-chars-min
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# For MySQL 8 in production/Docker:
DATABASE_URL=mysql+pymysql://scriptorium_user:scriptorium_password@localhost:3306/scriptorium_db?charset=utf8mb4
# For local development / SQLite fallback:
# DATABASE_URL=sqlite:///scriptorium.db

# -----------------------------------------------------------------------------
# Code Execution & Judge Configuration
# -----------------------------------------------------------------------------
# Options: 'mock' (local deterministic simulator for dev/test) or 'judge0'
JUDGE_PROVIDER=mock
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE_TIMEOUT_SECONDS=5
JUDGE_MEMORY_LIMIT_MB=128

# -----------------------------------------------------------------------------
# CORS & Frontend Origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Port Bindings
# -----------------------------------------------------------------------------
PORT=5000
FRONTEND_PORT=5173

